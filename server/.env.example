# BambiFound Backend - Environment Variables Example

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://bambi_user:bambi_pass@localhost:5432/bambifound_db?schema=public
DIRECT_URL=postgresql://bambi_user:bambi_pass@localhost:5432/bambifound_db?schema=public

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=sk_test_your_paystack_secret_key_here

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=noreply@bambifound.com
BREVO_FROM_NAME=BambiFound

# AI API (OpenAI Primary & Groq Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Server Config & Auth
PORT=4000
JWT_SECRET=super_secret_jwt_access_key_bambifound_2025
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_bambifound_2025
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000

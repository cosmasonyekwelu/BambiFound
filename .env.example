# BambiFound - Environment Variables Example

# ==========================================
# 1. DATABASE CONFIGURATION (Neon PostgreSQL)
# ==========================================
# Primary connection string for Neon managed serverless PostgreSQL database (with pgvector)
DATABASE_URL=postgresql://bambi_user:bambi_pass@localhost:5432/bambifound_db?schema=public
# Direct connection string for Prisma migrations or connection pooling (if using Neon connection pooler)
DIRECT_URL=postgresql://bambi_user:bambi_pass@localhost:5432/bambifound_db?schema=public

# ==========================================
# 2. PAYMENTS (Paystack)
# ==========================================
# Secret API Key for Paystack checkout initialization and transaction verification (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
# Public Key for frontend Paystack inline popup / JS SDK integration (pk_test_... or pk_live_...)
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
# Webhook secret for HMAC SHA512 signature validation (uses PAYSTACK_SECRET_KEY if unspecified)
PAYSTACK_WEBHOOK_SECRET=sk_test_your_paystack_secret_key_here

# ==========================================
# 3. MEDIA & STORAGE (Cloudinary)
# ==========================================
# Cloudinary cloud name for media asset uploads and delivery
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# Cloudinary API Key for authenticating backend uploads
CLOUDINARY_API_KEY=your_cloudinary_api_key
# Cloudinary API Secret for generating HMAC SHA1 signatures
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# 4. TRANSACTIONAL EMAIL (Brevo)
# ==========================================
# Brevo (formerly Sendinblue) API v3 key for transactional emails
BREVO_API_KEY=your_brevo_api_key_here
# Sender email address for account notifications and payment receipts
BREVO_FROM_EMAIL=noreply@bambifound.com
# Sender display name
BREVO_FROM_NAME=BambiFound

# ==========================================
# 5. AI API & RECOMMENDATIONS (OpenAI & Groq Fallback)
# ==========================================
# Primary canonical AI service provider (OpenAI API key)
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI chat completion model name
OPENAI_MODEL=gpt-4o-mini
# Optional AI fallback provider (Groq API key) - retained within AI integration category
GROQ_API_KEY=your_groq_api_key_here
# Groq model name
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# AUTHENTICATION & APP SETTINGS
# ==========================================
PORT=4000
JWT_SECRET=super_secret_jwt_access_key_bambifound_2025
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_bambifound_2025
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000

# Client Config
VITE_API_URL=http://localhost:4000
